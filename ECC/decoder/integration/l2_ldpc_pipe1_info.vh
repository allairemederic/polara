// Widths of the S3 transaction information transported by the wrapper.
// Include after l2.tmp.h and define.tmp.h.
`ifndef L2_LDPC_PIPE1_INFO_VH
`define L2_LDPC_PIPE1_INFO_VH
`define L2_LDPC_FIFO_DEPTH 8
`define L2_LDPC_COUNT_WIDTH $clog2(`L2_LDPC_FIFO_DEPTH + 1)
`define L2_LDPC_DPATH_INFO_WIDTH (`L2_DATA_ARRAY_WIDTH + `PHY_ADDR_WIDTH + `MSG_MSHRID_WIDTH + `MSG_SRC_CHIPID_WIDTH + `MSG_SRC_X_WIDTH + `MSG_SRC_Y_WIDTH + `MSG_SRC_FBITS_WIDTH + `MSG_SDID_WIDTH + `MSG_LSID_WIDTH + `MSG_LSID_WIDTH + `PHY_ADDR_WIDTH + 1 + 1 + `L2_WAYS_WIDTH + `L2_OWNER_BITS + `L2_MESI_BITS + `L2_VD_BITS + `L2_SUBLINE_BITS + `L2_DI_BIT + `L2_P1_DATA_BUF_IN_WIDTH + 1 + `L2_STATE_ARRAY_WIDTH + `L2_STATE_ARRAY_WIDTH + `L2_DATA_INDEX_WIDTH + 1)
`ifndef NO_RTL_CSM
`define L2_LDPC_CTRL_INFO_WIDTH ((`MSG_TYPE_WIDTH + `MSG_DATA_SIZE_WIDTH + `MSG_CACHE_TYPE_WIDTH + 1 + `L2_DATA_SUBLINE_WIDTH + `MSG_MESI_BITS + `MSG_L2_MISS_BITS + 1 + 1 + 1 + `L2_MSHR_STATE_BITS + `L2_MSHR_INDEX_WIDTH + 1 + `L2_DIR_ARRAY_WIDTH + 1) + 1)
`else
`define L2_LDPC_CTRL_INFO_WIDTH (`MSG_TYPE_WIDTH + `MSG_DATA_SIZE_WIDTH + `MSG_CACHE_TYPE_WIDTH + 1 + `L2_DATA_SUBLINE_WIDTH + `MSG_MESI_BITS + `MSG_L2_MISS_BITS + 1 + 1 + 1 + `L2_MSHR_STATE_BITS + `L2_MSHR_INDEX_WIDTH + 1 + `L2_DIR_ARRAY_WIDTH + 1)
`endif
`endif
